{
  "name": "forklift-back-end",
  "version": "1.0.0",
  "description": "Backend base scaffold aligned with financial architecture",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "tsx --watch ./src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "test": "node --import tsx/esm --test \"src/**/*.test.ts\"",
    "test:on-machine-flow": "node --import tsx/esm --test src/integration-tests/on-machine-pickup-flow.integration.ts src/integration-tests/trip-route-suggestion.integration.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:reset": "prisma migrate reset && prisma db seed",
    "db:migrate:reset:force": "prisma migrate reset --force && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
