enum RoleUser {
  OPERATOR_MACHINE
  FORKLIFT_OPERATOR
  SUPPLY_OPERATOR
  LEADER
  SUPERVISOR
  MANAGER
  ADMIN
}

enum RequestStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ForkliftTaskStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ForkliftTaskType {
  DELIVER_TO_MACHINE
  ON_MACHINE
  PICKUP_TO_EXPEDITION
}

enum PriorityLevel {
  VERY_HIGH
  HIGH
  NORMAL
}
