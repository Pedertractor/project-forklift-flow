generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  PEDERTRACTOR
  TRACTOR
}

model User {
  id         String   @id @default(uuid())
  name       String
  employeeId Int
  isLogged   Boolean  @default(false)
  card       String
  unit       Unit
  password   String
  role       RoleUser

  sector   Sector? @relation(fields: [sectorId], references: [id])
  sectorId String?

  machineReplenishmentRequests MachineReplenishmentRequest[]  @relation("UserMachineRequests")
  movimentPalletTasks          MovimentPalletTask[]           @relation("UserMovimentPalletTasks")
  machines                     Machine[]                      @relation("MachineOperator")
  movimentPallets              MovimentPallet[]               @relation("MovimentPalletOperator")
  tripSuggestionsAccepted      MovimentPalletTripSuggestion[] @relation("TripSuggestionAcceptedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([card, unit])
}

model MachineReplenishmentRequest {
  id String @id @default(uuid())

  requestedBy   User   @relation("UserMachineRequests", fields: [requestedById], references: [id])
  requestedById String

  movementCube String

  destination   Machine @relation(fields: [destinationId], references: [id])
  destinationId String

  typeMovimentPallet TypeMovimentPallet @default(FORKLIFT)

  status        RequestStatus @default(CREATED)
  priorityLevel PriorityLevel @default(NORMAL)

  movimentPalletTasks MovimentPalletTask[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}

model MovimentPalletTask {
  id String @id @default(uuid())

  request   MachineReplenishmentRequest @relation(fields: [requestId], references: [id])
  requestId String

  type   ForkliftTaskType   @default(DELIVER_TO_MACHINE)
  status ForkliftTaskStatus @default(CREATED)

  assignedMovimentPallet   MovimentPallet? @relation(fields: [assignedMovimentPalletId], references: [id])
  assignedMovimentPalletId String?

  requestedBy   User   @relation("UserMovimentPalletTasks", fields: [requestedById], references: [id])
  requestedById String

  tripSuggestionAsDeliver MovimentPalletTripSuggestion? @relation("TripSuggestionDeliverTask")
  tripSuggestionAsPickup  MovimentPalletTripSuggestion? @relation("TripSuggestionPickupTask")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}

model MovimentPalletTripSuggestion {
  id     String                             @id @default(uuid())
  status MovimentPalletTripSuggestionStatus @default(OPEN)

  deliverTask   MovimentPalletTask @relation("TripSuggestionDeliverTask", fields: [deliverTaskId], references: [id], onDelete: Cascade)
  deliverTaskId String             @unique
  pickupTask    MovimentPalletTask @relation("TripSuggestionPickupTask", fields: [pickupTaskId], references: [id], onDelete: Cascade)
  pickupTaskId  String             @unique

  machine   Machine @relation(fields: [machineId], references: [id])
  machineId String

  typeMovimentPallet TypeMovimentPallet

  acceptedBy       User?   @relation("TripSuggestionAcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedByUserId String?

  assignedMovimentPallet   MovimentPallet? @relation("TripSuggestionAssignedPallet", fields: [assignedMovimentPalletId], references: [id])
  assignedMovimentPalletId String?

  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Machine {
  id       String @id @default(uuid())
  name     String
  position String

  typeMachine   TypeMachine @relation(fields: [typeMachineId], references: [id])
  typeMachineId String

  sector   Sector @relation(fields: [sectorId], references: [id])
  sectorId String

  user   User?   @relation("MachineOperator", fields: [userId], references: [id])
  userId String?

  machineReplenishmentRequests MachineReplenishmentRequest[]

  movimentPalletTripSuggestions MovimentPalletTripSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TypeMachine {
  id       String @id @default(uuid())
  name     String
  urlImage String

  machines Machine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CostCenter {
  id              String  @id @default(uuid())
  costCenterAPI   String  @unique
  costCenterValue String
  sector          Sector? @relation(fields: [sectorId], references: [id])
  sectorId        String?
}

model Sector {
  id         String @id @default(uuid())
  typeSector String

  costCenters CostCenter[]

  movimentPallets MovimentPallet[]
  machines        Machine[]

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovimentPallet {
  id   String             @id @default(uuid())
  code String             @unique
  type TypeMovimentPallet

  operator   User?   @relation("MovimentPalletOperator", fields: [operatorId], references: [id])
  operatorId String?

  sector   Sector? @relation(fields: [sectorId], references: [id])
  sectorId String?

  movimentPalletTasks MovimentPalletTask[]

  tripSuggestions MovimentPalletTripSuggestion[] @relation("TripSuggestionAssignedPallet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeMovimentPallet {
  PALLET_TRUCK
  FORKLIFT
}

enum RoleUser {
  OPERATOR_MACHINE
  FORKLIFT_OPERATOR
  FOLLOW_UP_OPERATOR
  SUPPLY_OPERATOR
  LEADER
  SUPERVISOR
  MANAGER
  ADMIN
}

enum RequestStatus {
  CREATED
  IN_PROGRESS
  ON_MACHINE
  COMPLETED
  CANCELED
}

enum ForkliftTaskStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ForkliftTaskType {
  DELIVER_TO_MACHINE
  ON_MACHINE
  PICKUP_TO_EXPEDITION
}

enum MovimentPalletTripSuggestionStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PriorityLevel {
  VERY_HIGH
  HIGH
  NORMAL
}
