meta {
  name: Get machine replenishment request by id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/machine-replenishment-requests/{{requestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Requer JWT: leitura (GET) para SUPPLY_OPERATOR, LEADER, ADMIN, SUPERVISOR, MANAGER.
  # Parametro de path: requestId (variavel requestId no environment).
}
