meta {
  name: List pending preparation
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/machine-replenishment-requests/pending-preparation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Requer JWT: SUPPLY_OPERATOR, LEADER ou ADMIN.
  # Usuario precisa ter sectorId (400 se sem setor).
  # Lista solicitacoes em AWAITING_PREPARATION do setor (abastecimento deve preparar prisma).
}
