meta {
  name: Create machine replenishment request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/machine-replenishment-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "destinationId": "{{machineId}}",
    "movementCube": "CUBO-09",
    "typeMovimentPallet": "FORKLIFT",
    "priorityLevel": "HIGH"
  }
}

docs {
  # Requer JWT: roles SUPPLY_OPERATOR, LEADER ou ADMIN.
  # O solicitante e o usuario do token (sub); nao envie requestedById no body.
  # Campos obrigatorios: destinationId, movementCube, typeMovimentPallet.
  # typeMovimentPallet: PALLET_TRUCK | FORKLIFT
  # Opcional: priorityLevel (VERY_HIGH | HIGH | NORMAL; padrao NORMAL).
  # Ajuste machineId no environment para um UUID de maquina existente.
}
