meta {
  name: Accept open pickup task
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/operator-moviment-pallet/tasks/{{pickupTaskId}}/accept-pickup
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Requer JWT: FORKLIFT_OPERATOR, FOLLOW_UP_OPERATOR ou ADMIN.
  # Vincule um MovimentPallet (POST my-moviment-pallet) antes.
  # Aceita retirada PICKUP_TO_EXPEDITION em CREATED quando a requisicao esta ON_MACHINE
  # (operador da maquina ja pediu retirada) e nao ha sugestao de viagem combinada, ou o front usa este fluxo.
  # 201: { "task": { ... } }
}
