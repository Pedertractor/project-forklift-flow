meta {
  name: List users
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Requer JWT com role ADMIN ou LEADER.
  # ADMIN: todos os usuarios.
  # LEADER: apenas usuarios com o mesmo sectorId do lider.
  # Retorna { users: [...] }; cada usuario inclui sectorId e sector (objeto ou null).
}
