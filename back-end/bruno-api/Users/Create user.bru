meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "card": "2287",
    "unit": "TRACTOR",
    "role": "OPERATOR_MACHINE",
    "sectorId": "{{sectorId}}"
  }  
  
}

vars:pre-request {
  baseUrl: http://127.0.0.1:3131/api
}

docs {
  # Requer JWT com role ADMIN ou LEADER.
  #
  # ADMIN: pode enviar `sectorId` (UUID) de qualquer setor existente, ou omitir / null para usuario sem setor.
  #
  # LEADER: deve estar vinculado a um setor. Se `sectorId` for omitido, o novo usuario recebe o mesmo setor do lider.
  # Se `sectorId` for informado, o setor deve existir e ter o mesmo `typeSector` do setor do lider (permite trocar entre setores do mesmo tipo).
  #
  # role aceito: OPERATOR_MACHINE | FORKLIFT_OPERATOR | SUPPLY_OPERATOR | LEADER | SUPERVISOR | MANAGER | ADMIN
}
