meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "card": "2287",
    "unit": "TRACTOR",
    "role": "ADMIN"
  }  
}

vars:pre-request {
  baseUrl: http://127.0.0.1:3131/api
}

docs {
  # Requer JWT com role ADMIN.
  # role aceito: OPERATOR_MACHINE | FORKLIFT_OPERATOR | SUPPLY_OPERATOR | LEADER | SUPERVISOR | MANAGER | ADMIN
}
