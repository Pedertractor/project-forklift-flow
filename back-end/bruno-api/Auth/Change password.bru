meta {
  name: Change password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "newPassword": "1234",
    "currentPassword": "1234"
  }
}

docs {
  # Requer JWT.
  # Em primeiro acesso, currentPassword pode ser omitido conforme regra do backend.
}
